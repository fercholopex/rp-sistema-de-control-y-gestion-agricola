generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "mysql"
}

enum EntityStatus {
  ACTIVE
  INACTIVE
}

enum SurfaceUnit {
  HECTARE
  SQUARE_METER
  ACRE
}

enum PaymentType {
  HOUR
  DAY
  WAGE
  WEEK
  MONTH
  OTHER
}

enum ProductCategory {
  FERTILIZER
  FUNGICIDE
  INSECTICIDE
  HERBICIDE
  ADJUVANT
  OTHER
}

enum ActivityCategory {
  PRACTICE
  IRRIGATION
  FERTILIZATION
  FUMIGATION
  HERBICIDE
  OTHER
}

enum ActivityStatus {
  DRAFT
  CONFIRMED
  PAID
  PENDING_PAYMENT
  CANCELLED
}

model User {
  id        String       @id @default(cuid())
  name      String
  email     String       @unique
  role      UserRole     @default(VIEWER)
  active    Boolean      @default(true)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  deletedAt DateTime?
  @@index([active, deletedAt])
}

enum UserRole {
  ADMIN
  MANAGER
  VIEWER
}

model Farm {
  id        String    @id @default(cuid())
  name      String
  location  String?
  latitude  Decimal?  @db.Decimal(10, 7)
  longitude Decimal?  @db.Decimal(10, 7)
  notes     String?   @db.Text
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  lots      Lot[]
}

model Lot {
  id             String      @id @default(cuid())
  farmId         String?
  name           String
  code           String      @unique
  surfaceArea    Decimal     @db.Decimal(12, 4)
  surfaceUnit    SurfaceUnit @default(HECTARE)
  location       String?
  latitude       Decimal?    @db.Decimal(10, 7)
  longitude      Decimal?    @db.Decimal(10, 7)
  centroid       Json?
  geoJson        Json?
  status         EntityStatus @default(ACTIVE)
  notes          String?     @db.Text
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  deletedAt      DateTime?
  farm           Farm?       @relation(fields: [farmId], references: [id], onDelete: Restrict)
  parcels        Parcel[]
  activities     AgriculturalActivity[]
  @@index([farmId, status, deletedAt])
  @@index([latitude, longitude])
}

model Parcel {
  id             String       @id @default(cuid())
  lotId          String
  name           String
  code           String       @unique
  surfaceArea    Decimal      @db.Decimal(12, 4)
  surfaceUnit    SurfaceUnit  @default(HECTARE)
  centroid       Json?
  geoJson        Json?
  status         EntityStatus @default(ACTIVE)
  notes          String?      @db.Text
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  deletedAt      DateTime?
  lot            Lot          @relation(fields: [lotId], references: [id], onDelete: Restrict)
  cropAssignments CropAssignment[]
  activities     AgriculturalActivity[]
  @@index([lotId, status, deletedAt])
}

model Crop {
  id          String       @id @default(cuid())
  name        String
  variety     String?
  status      EntityStatus @default(ACTIVE)
  description String?      @db.Text
  notes       String?      @db.Text
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  deletedAt   DateTime?
  assignments CropAssignment[]
  activities  AgriculturalActivity[]
  @@unique([name, variety])
  @@index([status, deletedAt])
}

model CropAssignment {
  id          String       @id @default(cuid())
  parcelId    String
  cropId      String
  startsAt    DateTime
  endsAt      DateTime?
  surfaceArea Decimal?     @db.Decimal(12, 4)
  notes       String?      @db.Text
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  parcel      Parcel       @relation(fields: [parcelId], references: [id], onDelete: Restrict)
  crop        Crop         @relation(fields: [cropId], references: [id], onDelete: Restrict)
  activities  AgriculturalActivity[]
  @@index([parcelId, startsAt, endsAt])
  @@index([cropId, startsAt])
}

model Employee {
  id           String       @id @default(cuid())
  fullName     String
  currentRate  Decimal      @db.Decimal(12, 2)
  paymentType  PaymentType
  paymentUnit  String
  status       EntityStatus @default(ACTIVE)
  hiredAt      DateTime?
  notes        String?      @db.Text
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  deletedAt    DateTime?
  laborEntries LaborEntry[]
  @@index([status, deletedAt])
}

model Unit {
  id          String       @id @default(cuid())
  code        String       @unique
  name        String
  dimension   String
  baseUnit    Boolean      @default(false)
  multiplier  Decimal      @default(1) @db.Decimal(16, 6)
  status      EntityStatus @default(ACTIVE)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  deletedAt   DateTime?
}

model ApplicationMethod {
  id          String       @id @default(cuid())
  name        String       @unique
  status      EntityStatus @default(ACTIVE)
  notes       String?      @db.Text
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  deletedAt   DateTime?
  activities  AgriculturalActivity[]
}

model WorkType {
  id          String       @id @default(cuid())
  name        String       @unique
  status      EntityStatus @default(ACTIVE)
  notes       String?      @db.Text
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  deletedAt   DateTime?
  activities  AgriculturalActivity[]
}

model Product {
  id           String          @id @default(cuid())
  code         String          @unique
  name         String
  category     ProductCategory
  baseUnitCode String
  currentPrice Decimal?        @db.Decimal(12, 4)
  supplier     String?
  active       Boolean         @default(true)
  notes        String?         @db.Text
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  deletedAt    DateTime?
  prices       ProductPriceHistory[]
  applications ProductApplication[]
  @@index([category, active, deletedAt])
}

model ProductPriceHistory {
  id        String    @id @default(cuid())
  productId String
  price     Decimal   @db.Decimal(12, 4)
  startsAt  DateTime
  endsAt    DateTime?
  createdAt DateTime  @default(now())
  product   Product   @relation(fields: [productId], references: [id], onDelete: Restrict)
  @@index([productId, startsAt, endsAt])
}

model AgriculturalActivity {
  id               String           @id @default(cuid())
  category         ActivityCategory
  occurredAt       DateTime
  lotId            String
  parcelId         String?
  cropId           String?
  cropAssignmentId String?
  workTypeId       String?
  methodId         String?
  status           ActivityStatus   @default(CONFIRMED)
  laborCost        Decimal          @default(0) @db.Decimal(12, 2)
  productCost      Decimal          @default(0) @db.Decimal(12, 2)
  applicationCost  Decimal          @default(0) @db.Decimal(12, 2)
  irrigationCost   Decimal          @default(0) @db.Decimal(12, 2)
  otherCost        Decimal          @default(0) @db.Decimal(12, 2)
  totalCost        Decimal          @default(0) @db.Decimal(12, 2)
  notes            String?          @db.Text
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  lot              Lot              @relation(fields: [lotId], references: [id], onDelete: Restrict)
  parcel           Parcel?          @relation(fields: [parcelId], references: [id], onDelete: Restrict)
  crop             Crop?            @relation(fields: [cropId], references: [id], onDelete: Restrict)
  cropAssignment   CropAssignment?  @relation(fields: [cropAssignmentId], references: [id], onDelete: Restrict)
  workType         WorkType?        @relation(fields: [workTypeId], references: [id], onDelete: Restrict)
  method           ApplicationMethod? @relation(fields: [methodId], references: [id], onDelete: Restrict)
  laborEntries     LaborEntry[]
  productApplications ProductApplication[]
  irrigation       IrrigationDetail?
  @@index([occurredAt, category, status])
  @@index([lotId, occurredAt])
  @@index([parcelId, occurredAt])
  @@index([cropId, occurredAt])
}

model LaborEntry {
  id             String                @id @default(cuid())
  activityId     String
  employeeId     String
  employeeName   String
  paymentType    PaymentType
  rateSnapshot   Decimal               @db.Decimal(12, 2)
  quantity       Decimal               @default(1) @db.Decimal(12, 4)
  allocationPct  Decimal?              @db.Decimal(5, 2)
  individualCost Decimal               @db.Decimal(12, 2)
  createdAt      DateTime              @default(now())
  activity       AgriculturalActivity  @relation(fields: [activityId], references: [id], onDelete: Restrict)
  employee       Employee              @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  @@index([activityId])
  @@index([employeeId])
}

model ProductApplication {
  id              String                @id @default(cuid())
  activityId      String
  productId       String
  productName     String
  quantity        Decimal               @db.Decimal(14, 4)
  unitCode        String
  unitPrice       Decimal               @db.Decimal(12, 4)
  productCost     Decimal               @db.Decimal(12, 2)
  createdAt       DateTime              @default(now())
  activity        AgriculturalActivity  @relation(fields: [activityId], references: [id], onDelete: Restrict)
  product         Product               @relation(fields: [productId], references: [id], onDelete: Restrict)
  @@index([activityId])
  @@index([productId])
}

model IrrigationDetail {
  id            String                @id @default(cuid())
  activityId    String                @unique
  startsAt      DateTime
  endsAt        DateTime
  durationHours Decimal               @db.Decimal(10, 2)
  ratePerHour   Decimal?              @db.Decimal(12, 4)
  rateCost      Decimal               @default(0) @db.Decimal(12, 2)
  waterCost     Decimal               @default(0) @db.Decimal(12, 2)
  valveCost     Decimal               @default(0) @db.Decimal(12, 2)
  operatorCost  Decimal               @default(0) @db.Decimal(12, 2)
  otherCost     Decimal               @default(0) @db.Decimal(12, 2)
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt
  activity      AgriculturalActivity  @relation(fields: [activityId], references: [id], onDelete: Restrict)
}

model WeatherCache {
  id          String    @id @default(cuid())
  latitude    Decimal   @db.Decimal(10, 7)
  longitude   Decimal   @db.Decimal(10, 7)
  queryType   String
  payload     Json
  expiresAt   DateTime
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  @@unique([latitude, longitude, queryType])
  @@index([expiresAt])
}

model AuditLog {
  id         String    @id @default(cuid())
  actorId    String?
  action     String
  entityType String
  entityId   String
  before     Json?
  after      Json?
  createdAt  DateTime  @default(now())
  @@index([entityType, entityId])
  @@index([actorId, createdAt])
}
