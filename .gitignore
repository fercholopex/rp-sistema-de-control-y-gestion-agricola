# Archivos locales que no deben incluirse en el repositorio.

# Dependencias
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# Cobertura de pruebas
/coverage

# Archivos generados de Next.js
/.next/
/out/

# Compilación de producción
/build

# Archivos del sistema y certificados
.DS_Store
*.pem

# Registros de diagnóstico
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Variables de entorno; solo se comparten los ejemplos
.env*
!.env.example
!**/.env.example

# Copias privadas y resultados temporales
/respaldos/
/tmp/
/test-results/

# vercel
.vercel

# Archivos generados de TypeScript
*.tsbuildinfo
next-env.d.ts

# Clientes generados heredados
/generated/

