# Copiar a .env. La contraseña vacía se admite cuando está configurada así en MySQL.
DB_HOST=localhost
DB_PORT=3306
DB_NAME=alcachofa_cultivos_db
DB_USER=
DB_PASSWORD=
PUERTO=3000
HOST_ESCUCHA=127.0.0.1
ORIGEN_FRONTEND=http://localhost:3000
# Duración absoluta de las sesiones persistidas. No se utilizan tokens JWT.
SESION_HORAS=12
# Habilitar únicamente detrás de un único proxy de confianza.
CONFIAR_PROXY=0
ZONA_HORARIA=America/Mexico_City
CLIMA_URL=https://api.open-meteo.com/v1/forecast
# Opcional: base del sistema anterior, en la misma instancia MySQL.
DB_ORIGEN=
